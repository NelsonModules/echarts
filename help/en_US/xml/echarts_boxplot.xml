  <language>en_US</language>
  <keyword>echarts.boxplot</keyword>
  <short_description>create a box plot.</short_description>
  <syntax>
    <syntax_item>c = echarts.boxplot(M)</syntax_item>
    <syntax_item>c = echarts.boxplot(labels, groups)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>M</param_name>
      <param_description>a matrix (one box per column).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>groups</param_name>
      <param_description>a cell array of vectors (one box per vector).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a box-and-whisker plot. Each box shows the minimum, quartiles, median and maximum.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.boxplot(randn(100, 4), 'Title', 'Distributions').show();]]></example_item_data>
      <example_item_img src="../../images/echarts_boxplot.png" align="middle" />
    </example_item>
  </examples>
