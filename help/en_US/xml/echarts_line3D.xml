  <language>en_US</language>
  <keyword>echarts.line3D</keyword>
  <short_description>create a 3D line / curve (echarts-gl).</short_description>
  <syntax>
    <syntax_item>c = echarts.line3D(x, y, z)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x, y, z</param_name>
      <param_description>vectors of the same length tracing a space curve.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a 3D line / curve (uses the bundled echarts-gl extension) that can be rotated.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[t = linspace(0, 10*pi, 600);
echarts.line3D(cos(t), sin(t), t/pi).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_line3D.png" align="middle" />
    </example_item>
  </examples>
