  <language>en_US</language>
  <keyword>echarts.fn</keyword>
  <short_description>mark JavaScript to inject into an option.</short_description>
  <syntax>
    <syntax_item>s = echarts.fn(code)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>code</param_name>
      <param_description>a JavaScript expression, usually an arrow function.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>a tagged string the rendered page revives into a function.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Mark a piece of JavaScript as a function to inject into an ECharts option (formatters, scriptable colors, symbol sizes).</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[c = echarts.bar({'a','b','c'}, [1 2 3]);
c.option('tooltip.formatter', echarts.fn('(p) => p.name + ": " + p.value'));
c.show();]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
