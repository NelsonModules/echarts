  <language>en_US</language>
  <keyword>echarts.lines</keyword>
  <short_description>create a lines chart (polylines).</short_description>
  <syntax>
    <syntax_item>c = echarts.lines(polylines)</syntax_item>
    <syntax_item>c = echarts.lines(X, Y)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>polylines</param_name>
      <param_description>a cell array where each element is an n-by-2 matrix of [x y] vertices.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>X, Y</param_name>
      <param_description>matrices with one polyline per column.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a lines chart: one or more polylines drawn on a cartesian plane with an animated trail.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[t = linspace(0, 2*pi, 100).';
echarts.lines({[cos(t) sin(t)], [2*cos(t) 2*sin(t)]}).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_lines.png" align="middle" />
    </example_item>
  </examples>
