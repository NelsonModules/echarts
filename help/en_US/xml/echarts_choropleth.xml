  <language>en_US</language>
  <keyword>echarts.choropleth</keyword>
  <short_description>create a world choropleth map.</short_description>
  <syntax>
    <syntax_item>c = echarts.choropleth(countries, values)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>countries</param_name>
      <param_description>a cell array of English country names as used by the map.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>the matching data.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a world choropleth map: each country is shaded by its value. The bundled world map is loaded automatically.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.choropleth({'France','China','Brazil'}, [10 40 25]).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_choropleth.png" align="middle" />
    </example_item>
  </examples>
  <see_also>
