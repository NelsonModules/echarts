  <language>en_US</language>
  <keyword>echarts.fromOption</keyword>
  <short_description>build a chart from a complete ECharts option.</short_description>
  <syntax>
    <syntax_item>c = echarts.fromOption(option)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>option</param_name>
      <param_description>a struct holding a full ECharts option (its 'series' may be a cell or struct array).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Build a chart from a complete ECharts option. This is the escape hatch for anything the typed helpers do not cover.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[opt.xAxis.data = {'a','b','c'};
opt.yAxis = struct();
opt.series = { struct('type','line','data',[1 3 2]) };
echarts.fromOption(opt).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_fromOption.png" align="middle" />
    </example_item>
  </examples>
  <see_also>
      <see_also_item>
        <link linkend="${echarts}echarts.chart">echarts.chart</link>
      </see_also_item>
  </see_also>
