  <language>en_US</language>
  <keyword>echarts.graph</keyword>
  <short_description>create a force-directed network graph.</short_description>
  <syntax>
    <syntax_item>c = echarts.graph(names, edges)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>names</param_name>
      <param_description>a cell array of node names.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>edges</param_name>
      <param_description>an m-by-2 matrix of 1-based node index pairs, or m-by-3 with a weight.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a force-directed network graph; nodes can be dragged and the view zoomed.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.graph({'A','B','C','D'}, [1 2; 1 3; 2 4; 3 4]).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_graph.png" align="middle" />
    </example_item>
  </examples>
