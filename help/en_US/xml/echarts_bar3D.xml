  <language>en_US</language>
  <keyword>echarts.bar3D</keyword>
  <short_description>create a 3D bar chart (echarts-gl).</short_description>
  <syntax>
    <syntax_item>c = echarts.bar3D(M)</syntax_item>
    <syntax_item>c = echarts.bar3D(xlabels, ylabels, M)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>M</param_name>
      <param_description>the matrix of bar heights.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>xlabels</param_name>
      <param_description>the column labels.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ylabels</param_name>
      <param_description>the row labels.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a 3D bar chart (uses the bundled echarts-gl extension): one bar per matrix entry, colored by height.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.bar3D(magic(6)).title('Magic square').show();]]></example_item_data>
      <example_item_img src="../../images/echarts_bar3D.png" align="middle" />
    </example_item>
  </examples>
