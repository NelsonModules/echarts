  <language>en_US</language>
  <keyword>echarts.effectScatter</keyword>
  <short_description>create a scatter chart with a ripple effect.</short_description>
  <syntax>
    <syntax_item>c = echarts.effectScatter(x, y)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>x values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>y</param_name>
      <param_description>y values.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a scatter chart whose points pulse with a ripple, to draw attention to highlighted points.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.effectScatter([1 2 3], [4 7 2]).title('Hotspots').show();]]></example_item_data>
      <example_item_img src="../../images/echarts_effectScatter.png" align="middle" />
    </example_item>
  </examples>
  <see_also>
      <see_also_item>
