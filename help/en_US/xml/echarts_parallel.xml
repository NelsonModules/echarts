  <language>en_US</language>
  <keyword>echarts.parallel</keyword>
  <short_description>create a parallel-coordinates plot.</short_description>
  <syntax>
    <syntax_item>c = echarts.parallel(dims, M)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>dims</param_name>
      <param_description>a cell array of axis names.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>M</param_name>
      <param_description>a matrix with one row per observation and one column per dimension.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a parallel-coordinates plot; each row is drawn as a polyline crossing every axis.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.parallel({'mpg','hp','weight'}, [30 90 2; 18 160 3.5]).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_parallel.png" align="middle" />
    </example_item>
  </examples>
