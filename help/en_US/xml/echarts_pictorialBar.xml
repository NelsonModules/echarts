  <language>en_US</language>
  <keyword>echarts.pictorialBar</keyword>
  <short_description>create a pictorial bar chart.</short_description>
  <syntax>
    <syntax_item>c = echarts.pictorialBar(labels, values)</syntax_item>
    <syntax_item>c = echarts.pictorialBar(..., 'Symbol', S)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>labels</param_name>
      <param_description>the category labels.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>one value per category.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'Symbol'</param_name>
      <param_description>an ECharts symbol name or 'path://...' (default 'circle').</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a pictorial bar chart: each bar is drawn as a repeated symbol.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.pictorialBar({'A','B','C'}, [5 8 3], 'Symbol', 'circle').show();]]></example_item_data>
      <example_item_img src="../../images/echarts_pictorialBar.png" align="middle" />
    </example_item>
  </examples>
