  <language>en_US</language>
  <keyword>echarts.palette</keyword>
  <short_description>named categorical color palette.</short_description>
  <syntax>
    <syntax_item>colors = echarts.palette(n)</syntax_item>
    <syntax_item>colors = echarts.palette(n, name)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>the number of colors.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>'echarts' (default), 'tableau', 'pastel', 'set2', 'dark2', 'bright', 'vintage', 'roma'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>a cell array of n hex colors.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Return a cell array of n hex colors from a named categorical palette, cycled when n exceeds the palette length.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[c = echarts.bar({'a','b','c'}, [1 2 3]);
c.colors(echarts.palette(3, 'vintage')).show();]]></example_item_data>
    </example_item>
  </examples>
