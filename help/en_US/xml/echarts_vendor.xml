  <language>en_US</language>
  <keyword>echarts.vendor</keyword>
  <short_description>download a library for offline rendering.</short_description>
  <syntax>
    <syntax_item>p = echarts.vendor()</syntax_item>
    <syntax_item>p = echarts.vendor('core', version)</syntax_item>
    <syntax_item>p = echarts.vendor(extensionName)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>target</param_name>
      <param_description>'core' (default) or an extension short name ('gl', 'wordcloud', 'liquidfill').</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>version</param_name>
      <param_description>an explicit core version.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>the path the library was written to.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Download a library into the module's thirdparty/ folder so it renders offline. Requires internet access.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.vendor();
echarts.vendor('wordcloud');]]></example_item_data>
    </example_item>
  </examples>
