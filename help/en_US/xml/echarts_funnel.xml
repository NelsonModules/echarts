  <language>en_US</language>
  <keyword>echarts.funnel</keyword>
  <short_description>create a funnel chart.</short_description>
  <syntax>
    <syntax_item>c = echarts.funnel(values)</syntax_item>
    <syntax_item>c = echarts.funnel(labels, values)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>labels</param_name>
      <param_description>the band names; when omitted they are 1..n.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>one value per band.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a funnel chart, one band per value (for example a conversion funnel).</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.funnel({'Visit','Cart','Order','Paid'}, [100 80 60 40]).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_funnel.png" align="middle" />
    </example_item>
  </examples>
