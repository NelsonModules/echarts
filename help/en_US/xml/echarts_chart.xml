  <language>en_US</language>
  <keyword>echarts.chart</keyword>
  <short_description>object-oriented ECharts chart.</short_description>
  <syntax>
    <syntax_item>c = echarts.chart(type)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>type</param_name>
      <param_description>the primary ECharts series type ('bar','line','scatter','pie', ...).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create an empty chart and fill it with the fluent methods (addSeries, title, legend, option, ...). Use the typed factory helpers (echarts.bar, echarts.line, ...) for the common cases, or echarts.fromOption for a ready option.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[c = echarts.chart('line');
c.labels({'a','b','c'});
c.addSeries([1 3 2], 'name', 'x');
c.show();]]></example_item_data>
      <example_item_img src="../../images/echarts_chart.png" align="middle" />
    </example_item>
  </examples>
