  <language>en_US</language>
  <keyword>echarts.surface</keyword>
  <short_description>create a 3D surface (echarts-gl).</short_description>
  <syntax>
    <syntax_item>c = echarts.surface(Z)</syntax_item>
    <syntax_item>c = echarts.surface(X, Y, Z)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>Z</param_name>
      <param_description>a height matrix over an implicit integer grid.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>X, Y, Z</param_name>
      <param_description>matrices of the same size, as produced by meshgrid.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a 3D surface (uses the bundled echarts-gl extension), colored by height and rotatable.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[[X, Y] = meshgrid(linspace(-3, 3, 40));
Z = sin(X) .* cos(Y);
echarts.surface(X, Y, Z).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_surface.png" align="middle" />
    </example_item>
  </examples>
