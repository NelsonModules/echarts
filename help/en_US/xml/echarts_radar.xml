  <language>en_US</language>
  <keyword>echarts.radar</keyword>
  <short_description>create a radar (spider) chart.</short_description>
  <syntax>
    <syntax_item>c = echarts.radar(axes, M)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>axes</param_name>
      <param_description>a cell array of indicator names.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>M</param_name>
      <param_description>a matrix with one row per series and one column per indicator.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>an echarts.chart object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create a radar chart. Each indicator axis is scaled to the data.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.radar({'Speed','Power','Range'}, [80 90 70; 70 60 90], 'Names', {'A','B'}).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_radar.png" align="middle" />
    </example_item>
  </examples>
  <see_also>
