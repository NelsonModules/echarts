  <language>fr_FR</language>
  <keyword>echarts.doughnut</keyword>
  <short_description>cree un graphique en anneau.</short_description>
  <syntax>
    <syntax_item>c = echarts.doughnut(values)</syntax_item>
    <syntax_item>c = echarts.doughnut(labels, values)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>labels</param_name>
      <param_description>les noms des parts ; par defaut 1..n.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>une valeur par part.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree un anneau : un camembert avec un centre creux.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.doughnut({'A','B','C'}, [30 45 25]).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_doughnut.png" align="middle" />
    </example_item>
  </examples>
