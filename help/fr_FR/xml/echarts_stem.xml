  <language>fr_FR</language>
  <keyword>echarts.stem</keyword>
  <short_description>cree un trace en batons.</short_description>
  <syntax>
    <syntax_item>c = echarts.stem(y)</syntax_item>
    <syntax_item>c = echarts.stem(x, y)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>les valeurs de x (par defaut 1..n).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>y</param_name>
      <param_description>les hauteurs des batons.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree un trace en batons : un marqueur a chaque (x, y) avec une fine ligne descendant jusqu'a la base.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[n = 0:30; echarts.stem(n, sin(n/3)).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_stem.png" align="middle" />
    </example_item>
  </examples>
