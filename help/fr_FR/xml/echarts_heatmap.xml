  <language>fr_FR</language>
  <keyword>echarts.heatmap</keyword>
  <short_description>cree une carte de chaleur.</short_description>
  <syntax>
    <syntax_item>c = echarts.heatmap(M)</syntax_item>
    <syntax_item>c = echarts.heatmap(xlabels, ylabels, M)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>M</param_name>
      <param_description>la matrice a afficher, une cellule par entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>xlabels</param_name>
      <param_description>les etiquettes de colonnes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ylabels</param_name>
      <param_description>les etiquettes de lignes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree une carte de chaleur de la matrice M, coloree par valeur avec une carte visuelle continue.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.heatmap(magic(6)).title('Magic square').show();]]></example_item_data>
      <example_item_img src="../../images/echarts_heatmap.png" align="middle" />
    </example_item>
  </examples>
