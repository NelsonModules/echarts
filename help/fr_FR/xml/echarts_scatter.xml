  <language>fr_FR</language>
  <keyword>echarts.scatter</keyword>
  <short_description>cree un nuage de points.</short_description>
  <syntax>
    <syntax_item>c = echarts.scatter(x, y)</syntax_item>
    <syntax_item>c = echarts.scatter(x, Y)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>les valeurs numeriques de x.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>un vecteur (une serie) ou une matrice (une serie par colonne).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree un nuage de points sur un axe des x numerique.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[x = randn(1, 200); y = x + 0.5 * randn(1, 200);
echarts.scatter(x, y).title('Correlation').show();]]></example_item_data>
      <example_item_img src="../../images/echarts_scatter.png" align="middle" />
    </example_item>
  </examples>
