  <language>fr_FR</language>
  <keyword>echarts.vendor</keyword>
  <short_description>telecharge une bibliotheque pour le rendu hors-ligne.</short_description>
  <syntax>
    <syntax_item>p = echarts.vendor()</syntax_item>
    <syntax_item>p = echarts.vendor('core', version)</syntax_item>
    <syntax_item>p = echarts.vendor(extensionName)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>target</param_name>
      <param_description>'core' (par defaut) ou un nom court d'extension ('gl', 'wordcloud').</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>version</param_name>
      <param_description>une version explicite du coeur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>le chemin ou la bibliotheque a ete ecrite.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Telecharge une bibliotheque dans le dossier thirdparty/ du module pour un rendu hors-ligne. Necessite un acces internet.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.vendor();
echarts.vendor('wordcloud');]]></example_item_data>
    </example_item>
  </examples>
