  <language>fr_FR</language>
  <keyword>echarts.tree</keyword>
  <short_description>cree un diagramme en arbre.</short_description>
  <syntax>
    <syntax_item>c = echarts.tree(root)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>root</param_name>
      <param_description>une structure avec un champ 'name' et un champ optionnel 'children' (tableau de cellules de sous-structures).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree un diagramme en arbre a partir d'une structure imbriquee.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[root = struct('name', 'root', 'children', {{struct('name','a'), struct('name','b')}});
echarts.tree(root).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_tree.png" align="middle" />
    </example_item>
  </examples>
