  <language>fr_FR</language>
  <keyword>echarts.map</keyword>
  <short_description>cree une serie de carte geographique.</short_description>
  <syntax>
    <syntax_item>c = echarts.map(regions, values)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>regions</param_name>
      <param_description>un tableau de cellules de noms de pays en anglais tels qu'utilises par la carte du monde embarquee.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>les donnees correspondantes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree une serie de carte geographique coloree par valeur sur la carte du monde embarquee. Voir echarts.choropleth pour la meme carte avec une carte visuelle prete.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.map({'France','China','Brazil'}, [10 40 25]).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_map.png" align="middle" />
    </example_item>
  </examples>
