  <language>fr_FR</language>
  <keyword>echarts.scatter3D</keyword>
  <short_description>cree un nuage de points 3D (echarts-gl).</short_description>
  <syntax>
    <syntax_item>c = echarts.scatter3D(x, y, z)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x, y, z</param_name>
      <param_description>des vecteurs de meme longueur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree un nuage de points 3D (utilise l'extension echarts-gl embarquee) ; les points sont colores par z et la scene tourne.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[t = linspace(0, 6*pi, 300);
echarts.scatter3D(cos(t).*t, sin(t).*t, t).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_scatter3D.png" align="middle" />
    </example_item>
  </examples>
