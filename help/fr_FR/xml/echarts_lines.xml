  <language>fr_FR</language>
  <keyword>echarts.lines</keyword>
  <short_description>cree un graphique de lignes (polylignes).</short_description>
  <syntax>
    <syntax_item>c = echarts.lines(polylines)</syntax_item>
    <syntax_item>c = echarts.lines(X, Y)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>polylines</param_name>
      <param_description>un tableau de cellules ou chaque element est une matrice n-par-2 de sommets [x y].</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>X, Y</param_name>
      <param_description>des matrices avec une polyligne par colonne.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree un graphique de lignes : une ou plusieurs polylignes dessinees sur un plan cartesien avec une traine animee.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[t = linspace(0, 2*pi, 100).';
echarts.lines({[cos(t) sin(t)], [2*cos(t) 2*sin(t)]}).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_lines.png" align="middle" />
    </example_item>
  </examples>
