  <language>fr_FR</language>
  <keyword>echarts.treemap</keyword>
  <short_description>cree un treemap.</short_description>
  <syntax>
    <syntax_item>c = echarts.treemap(data)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>data</param_name>
      <param_description>un tableau de cellules de noeuds imbriques, chacun une structure avec 'name' et 'value' ou 'children'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree un treemap ; l'aire d'un rectangle est proportionnelle a la valeur.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[n = {struct('name','A','value',10), struct('name','B','value',6)};
echarts.treemap(n).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_treemap.png" align="middle" />
    </example_item>
  </examples>
