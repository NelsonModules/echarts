  <language>fr_FR</language>
  <keyword>echarts.bar</keyword>
  <short_description>cree un diagramme en barres.</short_description>
  <syntax>
    <syntax_item>c = echarts.bar(Y)</syntax_item>
    <syntax_item>c = echarts.bar(labels, Y)</syntax_item>
    <syntax_item>c = echarts.bar(..., 'Names', C, 'Title', T)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>labels</param_name>
      <param_description>les etiquettes de categorie : un tableau de cellules de chaines ou un vecteur numerique. Optionnel ; par defaut 1..n.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>les donnees : un vecteur (une serie) ou une matrice (une serie par colonne).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'Names', C</param_name>
      <param_description>un tableau de cellules de noms de series.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'Title', T</param_name>
      <param_description>le titre du graphique.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree un diagramme en barres. Chaque colonne de Y est une serie partageant les etiquettes de categorie.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[c = echarts.bar({'Q1','Q2','Q3','Q4'}, [12 19 7 15]);
c.title('Quarterly revenue');
c.show();]]></example_item_data>
      <example_item_img src="../../images/echarts_bar.png" align="middle" />
    </example_item>
  </examples>
