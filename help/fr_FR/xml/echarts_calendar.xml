  <language>fr_FR</language>
  <keyword>echarts.calendar</keyword>
  <short_description>cree un calendrier de chaleur.</short_description>
  <syntax>
    <syntax_item>c = echarts.calendar(dates, values)</syntax_item>
    <syntax_item>c = echarts.calendar(dates, values, 'Range', R)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>dates</param_name>
      <param_description>les jours (un vecteur datetime ou des chaines 'aaaa-mm-jj').</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>la grandeur par jour.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'Range'</param_name>
      <param_description>l'etendue du calendrier (par defaut l'etendue des donnees).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree un calendrier de chaleur : une case coloree par jour.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[d = datetime(2024,1,1):datetime(2024,12,31);
echarts.calendar(d, rand(1, numel(d))).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_calendar.png" align="middle" />
    </example_item>
  </examples>
