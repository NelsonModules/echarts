  <language>fr_FR</language>
  <keyword>echarts.area</keyword>
  <short_description>cree une courbe en aires remplies.</short_description>
  <syntax>
    <syntax_item>c = echarts.area(Y)</syntax_item>
    <syntax_item>c = echarts.area(labels, Y)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>labels</param_name>
      <param_description>les categories de l'axe des x ; par defaut 1..n.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>un vecteur ou une matrice de colonnes partageant les etiquettes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree une courbe en aires : une courbe dont l'aire sous chaque serie est remplie. Combiner avec stack() pour un empilement.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.area({'Mon','Tue','Wed'}, [120 132 101]).title('Traffic').show();]]></example_item_data>
      <example_item_img src="../../images/echarts_area.png" align="middle" />
    </example_item>
  </examples>
