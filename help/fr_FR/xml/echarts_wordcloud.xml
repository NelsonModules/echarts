  <language>fr_FR</language>
  <keyword>echarts.wordcloud</keyword>
  <short_description>cree un nuage de mots.</short_description>
  <syntax>
    <syntax_item>c = echarts.wordcloud(words, weights)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>words</param_name>
      <param_description>un tableau de cellules de chaines.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>weights</param_name>
      <param_description>les grandeurs correspondantes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un objet echarts.chart.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Cree un nuage de mots : chaque mot est dimensionne par son poids. Utilise l'extension echarts-wordcloud embarquee.</p>
  </description>
  <used_function />
  <bibliography>https://echarts.apache.org/en/option.html</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[echarts.wordcloud({'Nelson','ECharts','charts'}, [40 30 20]).show();]]></example_item_data>
      <example_item_img src="../../images/echarts_wordcloud.png" align="middle" />
    </example_item>
  </examples>
